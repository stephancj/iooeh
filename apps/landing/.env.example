# Clé publique du widget Cloudflare Turnstile (peut être exposée au navigateur)
PUBLIC_TURNSTILE_SITE_KEY=

# ID de mesure Google Analytics 4 (G-XXXXXXXXXX), activé uniquement au build production
PUBLIC_GOOGLE_ANALYTICS_ID=

# Valeur content de la balise HTML Search Console (laisser vide si validation DNS)
PUBLIC_GOOGLE_SITE_VERIFICATION=
